<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SuiviMailles.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- WebDAV bloque les requêtes PUT s'il est installé sur le serveur. -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>
    </system.webServer>
  </location>
  <!-- App_Data n'est jamais servi en statique. -->
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="App_Data" />
          <add segment="Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
