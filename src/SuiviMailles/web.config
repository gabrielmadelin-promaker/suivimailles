<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\SuiviMailles.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Pas de section <modules> : elle est souvent verrouillée au niveau du serveur (erreur 500.19).
           L'application n'utilise que GET et POST, WebDAV ne la gêne donc pas. -->
    </system.webServer>
  </location>
  <!-- App_Data et Data ne sont pas exposés : toutes les requêtes passent par l'application,
       qui ne sert en statique que le dossier wwwroot. -->
</configuration>
